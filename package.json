{
  "name": "openclaw-plivo-phone-channel",
  "version": "0.1.2",
  "description": "Real-time voice channel plugin for OpenClaw over Plivo Audio Streaming. Phone conversations with the agent, inbound and outbound, with barge-in and keypad input.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "plivo-phone",
      "label": "Plivo Phone",
      "blurb": "Real-time voice conversations over Plivo Audio Streaming."
    },
    "compat": {
      "pluginApi": "2026.7",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1"
    }
  },
  "keywords": [
    "openclaw",
    "openclaw-channel",
    "plivo",
    "voice",
    "audio-streaming",
    "telephony"
  ],
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.5.13",
    "openclaw": "2026.7.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plivo-sdks/openclaw-plivo-phone-channel.git"
  },
  "bugs": {
    "url": "https://github.com/plivo-sdks/openclaw-plivo-phone-channel/issues"
  },
  "homepage": "https://github.com/plivo-sdks/openclaw-plivo-phone-channel#readme"
}
